{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":disableDependencyDashboard",
    "config:recommended",
    ":semanticCommits",
    "schedule:weekdays",
    "group:allNonMajor"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "minimumReleaseAge": "0 days",
    "enabled": true
  },
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Group Go minor and patch updates",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "go-minor-patch"
    },
    {
      "description": "Group test and dev tooling",
      "matchPackageNames": [
        "github.com/stretchr/testify"
      ],
      "groupName": "testing"
    },
    {
      "description": "Group Buildkite plugins",
      "matchManagers": [
        "buildkite"
      ],
      "groupName": "buildkite-plugins"
    },
    {
      "description": "Do not automerge major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
